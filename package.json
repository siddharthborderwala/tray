{
  "name": "tray",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter @tray-sh/worker build && bun run --filter @tray-sh/cli build && bun run --filter @tray-sh/site build",
    "test": "bun test apps packages",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.14"
}
