{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tray-sh",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": { "enabled": true },
}
