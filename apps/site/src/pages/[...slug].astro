---
// Docs pages are rendered on demand so the middleware can answer
// `Accept: text/markdown` on the same URL. Their Markdown twins are prerendered.
import { getEntry, render } from "astro:content";
import Docs from "../layouts/Docs.astro";
import Hero from "../components/Hero.astro";
import PageHeader from "../components/PageHeader.astro";
import { ALL_PAGES, PAGES, SITE_NAME, TAGLINE, markdownHref } from "../lib/site";

const path = `/${Astro.params.slug ?? ""}`;
const entry = ALL_PAGES.find((p) => p.href === path);
const doc = entry && (await getEntry("docs", entry.id));
if (!doc) return Astro.rewrite("/404");

const { Content, headings } = await render(doc);
const overview = doc.id === "index";
const inSidebar = PAGES.some((p) => p.id === doc.id);
const sections = inSidebar
  ? headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, label: h.text }))
  : [];
const title = overview ? `${SITE_NAME} · ${TAGLINE}` : `${doc.data.title} · ${SITE_NAME}`;
---

<Docs
  title={title}
  description={doc.data.description}
  markdown={markdownHref(doc.id)}
  current={doc.id}
  sections={sections}
  home={overview}
>
  {
    overview ? (
      <Hero eyebrow="Open source · Self-hosted on Cloudflare" title={doc.data.title} />
    ) : (
      <PageHeader title={doc.data.title} description={doc.data.description} note={doc.data.note} />
    )
  }
  <div class:list={["prose", `page-${doc.id}`]}>
    <Content />
  </div>
</Docs>
