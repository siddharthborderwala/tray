---
/** The `tray.` wordmark: bold "tray" and a square blue period. */
interface Props {
  href?: string;
}
const { href } = Astro.props;
const Tag = href ? "a" : "span";
---

<Tag class="wordmark" href={href} aria-label={href ? "tray, home" : undefined}>
  <span aria-hidden={href ? "true" : undefined}>tray</span><span class="period" aria-hidden="true"></span>
</Tag>
