---
/** The `tray.` wordmark: outlined "tray" and a square blue period, shared with the Worker's pages. */
import { markSvg } from "@tray-sh/worker/mark";
interface Props {
  href?: string;
}
const { href } = Astro.props;
const Tag = href ? "a" : "span";
const svg = markSvg("var(--blue)", href ? "tray, home" : "tray");
---

<Tag class="wordmark" href={href} set:html={svg} />
