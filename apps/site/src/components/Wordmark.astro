---
/** The `tray.` wordmark: bold "tray" and a square period. */
interface Props {
  /** Color of the period. */
  period?: "ink" | "blue";
  href?: string;
}
const { period = "ink", href } = Astro.props;
const Tag = href ? "a" : "span";
---

<Tag class="wordmark" href={href} aria-label={href ? "tray, home" : undefined}>
  <span aria-hidden={href ? "true" : undefined}>tray</span><span class:list={["period", period]} aria-hidden="true"></span>
</Tag>
