---
import Wordmark from "./Wordmark.astro";
import { GITHUB_URL, PAGES, VERSION } from "../lib/site";

interface Props {
  /** Current page id, if any. */
  current?: string;
  /** h2 sections of the current page. */
  sections?: { id: string; label: string }[];
}
const { current, sections = [] } = Astro.props;
---

<aside class="sidebar">
  <div class="sidebar-top">
    <Wordmark href="/" />
    <button class="menu" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
  </div>
  <div class="sidebar-nav" id="site-nav">
    <nav aria-label="Docs">
      <ul class="pages">
        {
          PAGES.map((p) => (
            <li>
              <a href={p.href} class="page" aria-current={p.id === current ? "page" : undefined}>
                {p.label}
              </a>
              {p.id === current && sections.length > 0 && (
                <ul class="toc">
                  {sections.map((s) => (
                    <li>
                      <a href={`#${s.id}`} data-spy={s.id}>
                        {s.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="meta">
      <span>{VERSION}</span> · <a href={GITHUB_URL}>GitHub</a> · <a href="/llms.txt">llms.txt</a>
    </p>
  </div>
</aside>
