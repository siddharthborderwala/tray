---
import Wordmark from "./Wordmark.astro";
import { AUTHOR_NAME, AUTHOR_URL, MOTTO } from "../lib/site";
---

<footer class="footer">
  <div class="footer-row">
    <div class="footer-brand">
      <Wordmark period="blue" />
      <p>{MOTTO}</p>
    </div>
    <p class="made">
      Made with <span class="heart" aria-hidden="true">♥</span><span class="sr-only">love</span>{" "}by{" "}<a href={AUTHOR_URL} rel="author noopener" target="_blank"
        >{AUTHOR_NAME}&nbsp;↗<span class="sr-only"> (opens in a new tab)</span></a
      >
    </p>
  </div>
</footer>
