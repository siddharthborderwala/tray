---
import Wordmark from "./Wordmark.astro";
import { AUTHOR_NAME, AUTHOR_URL, FOOTER_PAGES, MOTTO } from "../lib/site";
---

<footer class="footer">
  <div class="footer-row">
    <div class="footer-brand">
      <Wordmark />
      <p>{MOTTO}</p>
    </div>
    <div class="footer-end">
      <nav aria-label="About Tray">
        <ul class="footer-links">
          {
            FOOTER_PAGES.map((p) => (
              <li>
                <a href={p.href}>{p.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <p class="made">
        Made with <span class="heart" role="img" aria-label="love">♥</span> by{" "}<a
          href={AUTHOR_URL}
          rel="author">{AUTHOR_NAME}&nbsp;↗</a
        >
      </p>
    </div>
  </div>
</footer>
