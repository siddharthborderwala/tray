// Local development only (`bun run dev`). Production Workers are created by
// `tray setup`, which uploads dist/worker.js with the same bindings via the
// Cloudflare API. Locally, wrangler runs that same file: Bun builds it (the
// toolbar is inlined by a Bun macro, which wrangler's bundler can't run), so
// wrangler doesn't bundle anything.
//
// Locally, *.localhost resolves to 127.0.0.1, so with DOMAIN=localhost:
//   http://tray.localhost:8787/v1/...   API
//   http://<site>.localhost:8787/       sites
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tray",
  "main": "dist/worker.js",
  "no_bundle": true,
  "compatibility_date": "2026-10-01",
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "tray-dev" }],
  "vars": {
    "DOMAIN": "localhost",
    // Allows DOMAIN=localhost. Local only: tray setup never sets it.
    "TRAY_DEV": "1",
    "OWNER_EMAIL": "you@example.com",
    "WORKER_NAME": "tray",
    // ACCESS_TEAM_DOMAIN, ACCESS_APPROVE_AUD, ACCESS_SIGNIN_AUD, ACCESS_SIGNIN_APP_ID,
    // CF_ACCOUNT_ID: set to test Access / custom domains. CF_API_TOKEN: put it in .dev.vars.
  },
}
